# Copy to .env and fill in. Never commit .env.
OPNSENSE_URL=https://firewall.example.internal
# Read API user: least-privilege, see the privilege table in README.md
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# TLS: set a CA bundle path for a self-signed firewall cert (preferred),
# or OPNSENSE_VERIFY_SSL=false to skip verification (not recommended).
OPNSENSE_CA_BUNDLE=
OPNSENSE_VERIFY_SSL=true
OPNSENSE_TIMEOUT=15

# --- Writes (optional). A SECOND API user, privileges for firewall rules and
# aliases only. Without these, no change tools are registered.
# OPNSENSE_WRITE_API_KEY=
# OPNSENSE_WRITE_API_SECRET=
# OPNSENSE_GUARD_POLICY=policy.yaml
# OPNSENSE_GUARD_DATA_DIR=data        # audit.jsonl + journal.sqlite

# --- HTTP mode (optional; default transport is stdio) ---
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8848
# OPNSENSE_GUARD_TOKENS_FILE=tokens.json
# MCP_TLS_CERT=
# MCP_TLS_KEY=
# MCP_TLS_CLIENT_CA=
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# MCP_RATE_LIMIT_PER_MIN=120
# MCP_ALLOW_PLAINTEXT=false
